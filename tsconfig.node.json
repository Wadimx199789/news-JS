{
    "compilerOptions": {
        "strict": true,

        "target": "ES2022",
        "module": "NodeNext",
        "types": ["node"],

        "noEmit": true,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["webpack*.ts"]
}
